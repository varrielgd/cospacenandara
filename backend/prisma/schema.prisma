generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum ImporterStatus {
  NEW
  CONTACTED
  REPLIED
  SAMPLE_REQUESTED
  SAMPLE_SENT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum SampleStatus {
  INQUIRY
  QUALIFICATION
  REQUESTED
  QUOTED
  PAYMENT_CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  FEEDBACK_RECEIVED
  COMMERCIAL_ORDER
  CANCELLED
}

enum SampleFormat {
  GREEN_BEANS
  ROASTED_BEANS
  GROUND_COFFEE
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuotationType {
  SAMPLE
  COMMERCIAL
}

enum ShipmentType {
  AIR_FREIGHT
  LCL_SHIPMENT
  FCL_SHIPMENT
  SAMPLE_ORDER
}

enum PackagingOption {
  VACUUM_GRAINPRO_5KG
  GRAINPRO_10_15KG
  GRAINPRO_JUTE_30_60KG
}

enum PaymentTerms {
  TT_50_DEPOSIT_50_BEFORE_SHIPMENT
  LC_AT_SIGHT
}

enum Incoterm {
  FOB
  CIF
  EXW
  CNF
}

enum EmailValidationStatus {
  VALID
  INVALID
  CATCH_ALL
  UNKNOWN
}

enum LeadScore {
  APLUS @map("A+")
  A
  BPLUS @map("B+")
  B
  C
}

enum DiscoveryStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  password          String
  firstName         String?
  lastName          String?
  role              String              @default("USER")
  isVerified        Boolean             @default(false)
  twoFactorSecret   String?
  twoFactorEnabled  Boolean             @default(false)
  verificationCode  String?
  verificationExpiry DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  auditLogs         AuditLog[]
  activities        Activity[]
  tasks             Task[]
  notes             Note[]
  discoverySessions DiscoverySession[]
}

model Importer {
  id                   String               @id @default(uuid())
  companyName          String
  website              String?              @unique
  email                String?              @unique
  phone                String?
  whatsapp             String?
  linkedin             String?
  country              String?
  city                 String?
  state                String?
  address              String?
  coffeeType           String?
  greenBeanInterest    Boolean              @default(false)
  roastedBeanInterest  Boolean              @default(false)
  leadScore            LeadScore?
  confidenceScore      Float?
  status               ImporterStatus       @default(NEW)
  notes                String?
  emailValidation      EmailValidationStatus @default(UNKNOWN)
  emailValidatedAt     DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  
  // New fields from the image
  businessType         String?              // e.g., Importer, Roaster, Distributor
  primaryContactName   String?
  primaryContactEmail  String?
  importLicenseNumber  String?
  annualVolumeBags     Int?                 // Annual volume (60kg bags)
  estimatedBuyingCapacity Float?            // Estimated buying capacity ($)
  targetMoqBags        Int?                 // Target MOQ (60kg bags)
  preferredIncoterm    Incoterm?            // Preferred Incoterm
  isRepeatClient       Boolean              @default(false)
  
  contacts             Contact[]
  emails               Email[]
  samples              Sample[]
  quotations           Quotation[]
  activities           Activity[]          @relation("ImporterActivities")
  importerNotes        Note[]               @relation("ImporterNotes")
  tasks                Task[]               @relation("ImporterTasks")
  attachments          Attachment[]
}

model Contact {
  id          String   @id @default(uuid())
  importerId  String
  importer    Importer @relation(fields: [importerId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String?
  jobTitle    String?
  email       String?
  phone       String?
  linkedin    String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum EmailStatus {
  DRAFT
  SENT
  APPROVED
  RECEIVED
  BOUNCED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model Email {
  id            String         @id @default(uuid())
  importerId    String?
  importer      Importer?      @relation(fields: [importerId], references: [id], onDelete: Cascade)
  messageId     String?        @unique // From Hostinger
  subject       String
  body          String
  from          String
  to            String?
  cc            String?
  bcc           String?
  status        EmailStatus    @default(DRAFT)
  direction     EmailDirection @default(OUTBOUND)
  isAiGenerated Boolean        @default(false)
  sentAt        DateTime?
  receivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Sample {
  id             String       @id @default(uuid())
  importerId     String
  importer       Importer     @relation(fields: [importerId], references: [id], onDelete: Cascade)
  product        String
  format         SampleFormat @default(GREEN_BEANS)
  weight         String       // e.g., "300g", "500g", "1kg"
  trackingNumber String?
  courier        String?      // e.g., "DHL", "FedEx", "EMS", "Cargo"
  destination    String
  status         SampleStatus @default(INQUIRY)
  paymentStatus  String       @default("PENDING") // PENDING, CONFIRMED
  shipmentDate   DateTime?
  deliveryDate   DateTime?
  feedback       String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique
  importerId      String
  importer        Importer        @relation(fields: [importerId], references: [id], onDelete: Cascade)
  type            QuotationType   @default(COMMERCIAL)
  shipmentType    ShipmentType    @default(LCL_SHIPMENT)
  packaging       PackagingOption @default(GRAINPRO_JUTE_30_60KG)
  paymentTerms    PaymentTerms    @default(TT_50_DEPOSIT_50_BEFORE_SHIPMENT)    
  incoterm        Incoterm        @default(FOB)
  product         String
  quantity        Float
  price           Float
  currency        String          @default("USD")
  leadTimeDays    Int             @default(21) // 14-21 days as per infographic 
  validUntil      DateTime
  status          QuotationStatus @default(DRAFT)
  pdfPath         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Activity {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  importerId  String?
  importer    Importer? @relation(fields: [importerId], references: [id], name: "ImporterActivities")       
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], name: "SupplierActivities")       
  type        String   // EMAIL, CALL, MEETING, NOTE, TASK
  description String
  createdAt   DateTime @default(now())
}

model Note {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  importerId      String?
  importer        Importer?     @relation(fields: [importerId], references: [id], onDelete: Cascade, name: "ImporterNotes")
  supplierId      String?
  supplier        Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Cascade, name: "SupplierNotes")
  content         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  importerId  String?
  importer    Importer? @relation(fields: [importerId], references: [id], name: "ImporterTasks")       
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], name: "SupplierTasks")       
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Attachment {
  id          String   @id @default(uuid())
  importerId  String
  importer    Importer @relation(fields: [importerId], references: [id], onDelete: Cascade)
  fileName    String
  filePath    String
  fileType    String
  fileSize    Int
  createdAt   DateTime @default(now())
}

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  region    String?
  createdAt DateTime @default(now())
}

model LeadSource {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String?  // SCRAPER, MANUAL, WEB_FORM
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model DiscoverySession {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])  
  query          String
  status         DiscoveryStatus @default(PENDING)
  totalFound     Int             @default(0)
  totalProcessed Int             @default(0)
  importerIds    String // JSON array of importer IDs found
  resultsJson    String? // Detailed results
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Supplier {
  id               String           @id @default(uuid())
  companyName      String
  website          String?          @unique
  email            String?          @unique
  phone            String?
  whatsapp         String?
  country          String?
  city             String?
  address          String?
  coffeeTypes      String?
  certifications   String?
  minimumOrderQty  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  supplierContacts SupplierContact[]
  supplierNotes    Note[]         @relation("SupplierNotes")
  activities       Activity[]     @relation("SupplierActivities")
  tasks            Task[]         @relation("SupplierTasks")
}

model SupplierContact {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String?
  jobTitle    String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
