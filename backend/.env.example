PORT=4000
NODE_ENV=production
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
JWT_SECRET="your-jwt-secret-key-here"

# AI Providers (Store in your platform's environment secrets, never commit)
# GROQ_API_KEY="your-groq-api-key"
# GROQ_MODEL="llama-3.3-70b-versatile"
# GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-3.5-flash"

# Scouting & Discovery
# SERPAPI_API_KEY="your-serpapi-key"
# SCRAPERAPI_API_KEY="your-scraperapi-key"

# Frontend
FRONTEND_URL=https://nandaracorporation.vercel.app/

# SMTP (Hostinger) - Configure via Email Settings in the app
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM_NAME="Your Company Name"
SMTP_SECURE=false

# IMAP (Hostinger) - Configure via Email Settings in the app
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER="your-email@example.com"
IMAP_PASS="your-email-password"
IMAP_SECURE=true

# Email Service Providers (optional - for cloud hosting with SMTP blocking)
# RESEND_API_KEY="your-resend-api-key" 
# BREVO_API_KEY="your-brevo-api-key"

# Google Sheets (optional)
# GOOGLE_SHEET_ID="your-sheet-id"
# GOOGLE_SCRIPT_URL="your-google-script-url"

VITE_API_URL=https://your-backend-url.com/api
